# --- Supabase ---
SUPABASE_URL=https://xidokjhitofjbcifmovy.supabase.co
SUPABASE_PROJECT_REF=xidokjhitofjbcifmovy
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct host (db.<ref>.supabase.co) is IPv6-only; use the IPv4 session pooler.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
STORAGE_BUCKET=issue-attachments

# --- Resend ---
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev
# Resend sandbox sender only delivers to the account owner's address; set it here to redirect all mail.
EMAIL_OVERRIDE_TO=

# --- App ---
APP_TIMEZONE=Europe/Warsaw
FRONTEND_URL=http://localhost:3000
SEED_PASSWORD=

# --- GitHub ---
GITHUB_REPO_URL=https://github.com/franekaczmarek/KTasks.git

# Comma-separated email domains allowed to self-register (empty = any domain)
ALLOWED_SIGNUP_DOMAINS=
